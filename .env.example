# ==============================================================================
# Stock Price Tracker — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values for local development.
# In prod (Railway), set these in the dashboard environment variables.
# ==============================================================================

# --- Core ---
# Base directory for data storage. Data lives at $STOCK_TRACKER_HOME/.stock-tracker/
# Local: defaults to process.cwd() if unset
# Prod (Railway): set to your volume mount path, e.g. /data
STOCK_TRACKER_HOME=

# --- Database (Postgres) ---
# Required for member trade journal and PnL tracking
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Discord Bot ---
# Required for the LLM chatbot in Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_ASK_CHANNEL_ID=

# --- Discord Webhooks ---
# Required for scan notifications to Discord channels
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_TECH_URL=

# --- Anthropic (Claude) ---
# Required for Discord chatbot and news summarization
ANTHROPIC_API_KEY=

# --- Puppeteer / Chart Generation ---
# Prod only: path to system Chromium (set automatically in Dockerfile)
# Leave unset locally — puppeteer (devDep) bundles its own Chromium
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# --- Optional ---
# Minimum confidence threshold for auto-journal entries (default: 0.55)
# AUTO_JOURNAL_MIN_CONFIDENCE=0.55
